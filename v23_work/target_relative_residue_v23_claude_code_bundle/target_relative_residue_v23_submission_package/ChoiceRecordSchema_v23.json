{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_type",
    "record_id",
    "review_instance_hash",
    "input_corpus_hash",
    "sequence_index",
    "node_id",
    "state_hash",
    "target_hash",
    "policy_hash",
    "candidates",
    "best_fitness_class",
    "best_candidate_ids",
    "selected_candidate_id",
    "selected_action",
    "choice_rationale",
    "triggering_challenge_ids"
  ],
  "properties": {
    "record_type": {
      "const": "choice_record"
    },
    "record_id": {
      "type": "string"
    },
    "review_instance_hash": {
      "type": "string"
    },
    "input_corpus_hash": {
      "type": "string"
    },
    "sequence_index": {
      "type": "integer",
      "minimum": 1
    },
    "node_id": {
      "type": "string"
    },
    "state_hash": {
      "type": "string"
    },
    "target_hash": {
      "type": "string"
    },
    "policy_hash": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "action_type",
          "operand_id",
          "applicability",
          "projected_outcome",
          "fitness_class",
          "evidence_refs",
          "comparison_rationale"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "action_type": {
            "enum": [
              "local",
              "global",
              "decompose",
              "acquire_info",
              "revise_model",
              "rollback",
              "halt_UB"
            ]
          },
          "operand_id": {
            "type": "string"
          },
          "applicability": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "applicable",
                  "inapplicable"
                ]
              },
              "witness": {
                "type": "string"
              }
            }
          },
          "projected_outcome": {
            "type": "object",
            "required": [
              "node_id",
              "summary",
              "feature_vector"
            ],
            "properties": {
              "node_id": {
                "type": "string"
              },
              "summary": {
                "type": "string",
                "minLength": 20
              },
              "feature_vector": {
                "type": "object"
              }
            }
          },
          "fitness_class": {
            "enum": [
              "f0",
              "f1",
              "f2",
              "f3",
              "f4"
            ]
          },
          "evidence_refs": {
            "type": "array"
          },
          "comparison_rationale": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "best_fitness_class": {
      "enum": [
        "f0",
        "f1",
        "f2",
        "f3",
        "f4"
      ]
    },
    "best_candidate_ids": {
      "type": "array",
      "minItems": 1
    },
    "selected_candidate_id": {
      "type": "string"
    },
    "selected_action": {
      "enum": [
        "local",
        "global",
        "decompose",
        "acquire_info",
        "revise_model",
        "rollback",
        "halt_UB"
      ]
    },
    "choice_rationale": {
      "type": "string",
      "minLength": 30
    },
    "triggering_challenge_ids": {
      "type": "array"
    }
  }
}
