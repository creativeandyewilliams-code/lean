{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_type",
    "record_id",
    "review_instance_hash",
    "input_corpus_hash",
    "sequence_index",
    "node_id",
    "choice_record_id",
    "selected_candidate_id",
    "selected_action",
    "validation_result",
    "execution_result",
    "native_result",
    "status_after",
    "unresolved_residue",
    "active_conditions",
    "budget_before",
    "budget_after",
    "history_before",
    "history_after",
    "evidence_refs"
  ],
  "properties": {
    "record_type": {
      "const": "execution_record"
    },
    "record_id": {
      "type": "string"
    },
    "review_instance_hash": {
      "type": "string"
    },
    "input_corpus_hash": {
      "type": "string"
    },
    "sequence_index": {
      "type": "integer",
      "minimum": 1
    },
    "node_id": {
      "type": "string"
    },
    "choice_record_id": {
      "type": "string"
    },
    "selected_candidate_id": {
      "type": "string"
    },
    "selected_action": {
      "enum": [
        "local",
        "global",
        "decompose",
        "acquire_info",
        "revise_model",
        "rollback",
        "halt_UB"
      ]
    },
    "validation_result": {
      "const": "valid"
    },
    "execution_result": {
      "type": "string",
      "minLength": 20
    },
    "native_result": {
      "type": "string"
    },
    "status_after": {
      "enum": [
        "conditionally accepted",
        "global coherence assessed"
      ]
    },
    "unresolved_residue": {
      "type": "array"
    },
    "active_conditions": {
      "type": "array"
    },
    "budget_before": {
      "type": "object"
    },
    "budget_after": {
      "type": "object"
    },
    "history_before": {
      "type": "string"
    },
    "history_after": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1
    }
  }
}
